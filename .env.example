# Copy this file to .env and fill in your Azure Document Intelligence values.
# Azure Portal: Resource → Keys and Endpoint

# Full endpoint URL (often ends with a trailing slash)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://YOUR_RESOURCE.cognitiveservices.azure.com/

# API key (Key 1 or Key 2)
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# OpenRouter — required for field extraction, risk scan, and background screening
# POST /api/reconciliation/evaluate
# POST /api/vetting/risk-scan
# POST /api/vetting/background-screening
OPENROUTER_API_KEY=

# Optional: override default extraction model (google/gemini-2.5-flash-lite)
# EVAL_EXTRACTION_MODEL=

# Optional: base model for background screening (:online is appended automatically)
# Default base: google/gemini-2.5-flash-lite → google/gemini-2.5-flash-lite:online
# OPENROUTER_BACKGROUND_MODEL=
